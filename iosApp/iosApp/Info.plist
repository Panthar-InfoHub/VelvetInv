<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
    <key>FirebaseAppDelegateProxyEnabled</key>
    <false/>
    <key>FirebaseMessagingInstallationIdEnabled</key>
    <true/>

    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Your location is recorded once with your KYC profile, as required by SEBI onboarding regulations.</string>

    <key>NSPhotoLibraryUsageDescription</key>
    <string>Allow access to photos so users can upload images inside the app.</string>

    <key>NSFaceIDUsageDescription</key>
    <string>Use Face ID to unlock Velvet instead of typing your PIN.</string>
</dict>
</plist>
